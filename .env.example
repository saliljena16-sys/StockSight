# Server-only (no VITE_ prefix): read by api/finnhub.js on Vercel and by the Vite dev server
# locally. It is never compiled into the browser bundle.
FINNHUB_API_KEY=your_finnhub_api_key_here

# Public, compiled into the bundle: the Supabase URL and anon key are designed to be exposed.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
